# Les fichiers deposes par les utilisateurs ne doivent JAMAIS etre executes.
# Sans cette protection, un fichier .php televerse dans ce dossier serait
# execute par Apache, ce qui donne le controle du serveur.
php_flag engine off
<IfModule mod_php.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(?i:php|php3|php4|php5|php7|php8|phtml|phar|cgi|pl|py|sh)$">
    Require all denied
</FilesMatch>
Options -ExecCGI -Indexes
AddType text/plain .php .phtml .phar
